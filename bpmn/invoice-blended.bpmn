<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_InvoiceBlended" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Workshop deck generator" exporterVersion="1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="InvoiceBlended" name="Invoice approval with dispute agent" isExecutable="true">
    <bpmn:startEvent id="start" name="Invoice received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="categorize" name="Categorize invoice">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_amount" name="Amount &gt; €500?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approve" name="Approve invoice">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_approved" name="Approved?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_join">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="pay" name="Pay invoice">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="archive" name="Archive invoice">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_paid" name="Invoice paid">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:adHocSubProcess id="agent" name="Dispute agent">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:serviceTask id="get_account" name="Get account details">
      </bpmn:serviceTask>
      <bpmn:sendTask id="contact" name="Contact sales rep">
      </bpmn:sendTask>
      <bpmn:userTask id="display" name="Display findings to clerk">
      </bpmn:userTask>
      <bpmn:serviceTask id="cancel" name="Cancel invoice">
      </bpmn:serviceTask>
      <bpmn:serviceTask id="create" name="Create new invoice">
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="end_resolved" name="Dispute resolved">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="categorize" />
    <bpmn:sequenceFlow id="f2" sourceRef="categorize" targetRef="gw_amount" />
    <bpmn:sequenceFlow id="f3" name="Yes" sourceRef="gw_amount" targetRef="approve" />
    <bpmn:sequenceFlow id="f4" name="No" sourceRef="gw_amount" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f5" sourceRef="approve" targetRef="gw_approved" />
    <bpmn:sequenceFlow id="f6" name="Yes" sourceRef="gw_approved" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f7" name="No" sourceRef="gw_approved" targetRef="agent" />
    <bpmn:sequenceFlow id="f8" sourceRef="gw_join" targetRef="pay" />
    <bpmn:sequenceFlow id="f9" sourceRef="pay" targetRef="archive" />
    <bpmn:sequenceFlow id="f10" sourceRef="archive" targetRef="end_paid" />
    <bpmn:sequenceFlow id="f11" sourceRef="agent" targetRef="end_resolved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_InvoiceBlended">
    <bpmndi:BPMNPlane id="BPMNPlane_InvoiceBlended" bpmnElement="InvoiceBlended">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="150" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="113.0" y="224" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="categorize_di" bpmnElement="categorize">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_amount_di" bpmnElement="gw_amount" isMarkerVisible="true">
        <dc:Bounds x="400" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="370.0" y="231" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_approved_di" bpmnElement="gw_approved" isMarkerVisible="true">
        <dc:Bounds x="660" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="630.0" y="143" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_join_di" bpmnElement="gw_join" isMarkerVisible="true">
        <dc:Bounds x="760" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pay_di" bpmnElement="pay">
        <dc:Bounds x="860" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="archive_di" bpmnElement="archive">
        <dc:Bounds x="1010" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_paid_di" bpmnElement="end_paid">
        <dc:Bounds x="1160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1123.0" y="224" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="agent_di" bpmnElement="agent" isExpanded="true">
        <dc:Bounds x="720" y="290" width="400" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="get_account_di" bpmnElement="get_account">
        <dc:Bounds x="750" y="325" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contact_di" bpmnElement="contact">
        <dc:Bounds x="870" y="325" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="display_di" bpmnElement="display">
        <dc:Bounds x="990" y="325" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cancel_di" bpmnElement="cancel">
        <dc:Bounds x="810" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="create_di" bpmnElement="create">
        <dc:Bounds x="930" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_resolved_di" bpmnElement="end_resolved">
        <dc:Bounds x="1180" y="387" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1143.0" y="429" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="186" y="200.0" />
        <di:waypoint x="240" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="340" y="200.0" />
        <di:waypoint x="400" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="450" y="200.0" />
        <di:waypoint x="500" y="200.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="452" y="183" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="425" y="175" />
        <di:waypoint x="425" y="110" />
        <di:waypoint x="785" y="110" />
        <di:waypoint x="785" y="175" />
        <bpmndi:BPMNLabel><dc:Bounds x="430" y="148" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="600" y="200.0" />
        <di:waypoint x="660" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="710" y="200.0" />
        <di:waypoint x="760" y="200.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="712" y="183" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="685.0" y="225" />
        <di:waypoint x="685.0" y="405.0" />
        <di:waypoint x="720" y="405.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="690" y="238" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="810" y="200.0" />
        <di:waypoint x="860" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="960" y="200.0" />
        <di:waypoint x="1010" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="1110" y="200.0" />
        <di:waypoint x="1160" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
        <di:waypoint x="1120" y="405.0" />
        <di:waypoint x="1180" y="405.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
