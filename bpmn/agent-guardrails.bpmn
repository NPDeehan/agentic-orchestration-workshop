<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_AgentGuardrails" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Workshop deck generator" exporterVersion="1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="AgentGuardrails" name="Agent guardrails" isExecutable="true">
    <bpmn:startEvent id="start" name="Request">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="agent" name="Onboarding agent">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:serviceTask id="search" name="Search for customer">
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="escalate" name="Escalate: out of scope">
        <bpmn:escalationEventDefinition id="escalate_esc" escalationRef="Escalation_OutOfScope" />
      </bpmn:intermediateThrowEvent>
      <bpmn:businessRuleTask id="policy" name="Check account policy">
        <bpmn:outgoing>f3</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="gw_policy" name="Allowed?">
        <bpmn:incoming>f3</bpmn:incoming>
        <bpmn:outgoing>f4</bpmn:outgoing>
        <bpmn:outgoing>f5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="create_account" name="Create account">
        <bpmn:incoming>f4</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="end_refused" name="Refused">
        <bpmn:incoming>f5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="approve" name="Approve deletion">
        <bpmn:outgoing>f6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="gw_approve" name="Approved?">
        <bpmn:incoming>f6</bpmn:incoming>
        <bpmn:outgoing>f7</bpmn:outgoing>
        <bpmn:outgoing>f8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="delete" name="Delete customer">
        <bpmn:incoming>f7</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="end_rejected" name="Rejected">
        <bpmn:incoming>f8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="f3" sourceRef="policy" targetRef="gw_policy" />
      <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="gw_policy" targetRef="create_account" />
      <bpmn:sequenceFlow id="f5" name="No" sourceRef="gw_policy" targetRef="end_refused" />
      <bpmn:sequenceFlow id="f6" sourceRef="approve" targetRef="gw_approve" />
      <bpmn:sequenceFlow id="f7" name="Yes" sourceRef="gw_approve" targetRef="delete" />
      <bpmn:sequenceFlow id="f8" name="No" sourceRef="gw_approve" targetRef="end_rejected" />
    </bpmn:adHocSubProcess>
    <bpmn:boundaryEvent id="boundary_esc" attachedToRef="agent">
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="boundary_esc_esc" escalationRef="Escalation_OutOfScope" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="handle" name="Handle escalation">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_esc" name="Escalated">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="agent" />
    <bpmn:sequenceFlow id="f2" sourceRef="agent" targetRef="end" />
    <bpmn:sequenceFlow id="f9" sourceRef="boundary_esc" targetRef="handle" />
    <bpmn:sequenceFlow id="f10" sourceRef="handle" targetRef="end_esc" />
  </bpmn:process>
  <bpmn:escalation id="Escalation_OutOfScope" name="Out of scope" escalationCode="OUT_OF_SCOPE" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_AgentGuardrails">
    <bpmndi:BPMNPlane id="BPMNPlane_AgentGuardrails" bpmnElement="AgentGuardrails">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="150" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="113.0" y="304" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="agent_di" bpmnElement="agent" isExpanded="true">
        <dc:Bounds x="240" y="100" width="840" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="search_di" bpmnElement="search">
        <dc:Bounds x="290" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
