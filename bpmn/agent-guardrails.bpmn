      <bpmndi:BPMNShape id="gw_policy_di" bpmnElement="gw_policy" isMarkerVisible="true">
        <dc:Bounds x="440" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="410.0" y="271" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="create_account_di" bpmnElement="create_account">
        <dc:Bounds x="530" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_refused_di" bpmnElement="end_refused">
        <dc:Bounds x="447" y="390" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="410.0" y="432" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="700" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_approve_di" bpmnElement="gw_approve" isMarkerVisible="true">
        <dc:Bounds x="850" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="820.0" y="271" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="delete_di" bpmnElement="delete">
        <dc:Bounds x="940" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rejected_di" bpmnElement="end_rejected">
        <dc:Bounds x="857" y="390" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="820.0" y="432" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary_esc_di" bpmnElement="boundary_esc">
        <dc:Bounds x="642" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handle_di" bpmnElement="handle">
        <dc:Bounds x="740" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_esc_di" bpmnElement="end_esc">
        <dc:Bounds x="900" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="863.0" y="584" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1140" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1103.0" y="304" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="186" y="280.0" />
        <di:waypoint x="240" y="280.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="1080" y="280.0" />
        <di:waypoint x="1140" y="280.0" />
      </bpmndi:BPMNEdge>
